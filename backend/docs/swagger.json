{
    "swagger": "2.0",
    "info": {
        "description": "API сервиса чата с ИИ и управления заявками",
        "title": "AI Chat \u0026 Leads API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/chat": {
            "post": {
                "description": "Принимает сообщение пользователя, запрашивает ответ у LLM, сохраняет историю в БД, обновляет профиль/сессию и возвращает ответ ИИ",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chat"
                ],
                "summary": "Отправить сообщение в чат",
                "parameters": [
                    {
                        "description": "Сообщение от пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.UserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.FrontHistoryMessageForm"
                        }
                    },
                    "400": {
                        "description": "Неверный формат JSON",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    },
                    "500": {
                        "description": "Ошибка записи или обновления в БД",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    },
                    "503": {
                        "description": "Ошибка при получении ответа от LLM",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "description": "Возвращает статус работы сервера",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Проверка работоспособности сервера",
                "responses": {
                    "200": {
                        "description": "{\"status\": \"Server Alive\"}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/leads": {
            "post": {
                "description": "Принимает контактные данные клиента, подтягивает последние рекомендованные товары и сохраняет заявку в БД",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "leads"
                ],
                "summary": "Создать заявку (лид)",
                "parameters": [
                    {
                        "description": "Данные формы заявки",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.ManagerStatementForm"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.LeadForm"
                        }
                    },
                    "400": {
                        "description": "Неверный формат JSON",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    },
                    "500": {
                        "description": "Ошибка поиска или записи в БД",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    }
                }
            }
        },
        "/api/login/cookie": {
            "get": {
                "description": "Проверяет cookie_id из запроса, находит пользователя в БД и возвращает его данные",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Авторизация по Cookie",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.RegisterResponse"
                        }
                    },
                    "500": {
                        "description": "Ошибка проверки cookie или поиска пользователя в БД",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    }
                }
            }
        },
        "/api/login/manual": {
            "post": {
                "description": "Аутентифицирует пользователя по логину и паролю и создает новую сессионную cookie в БД",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Вход по логину и паролю",
                "parameters": [
                    {
                        "description": "Логин и пароль пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.CustomerLoginData"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный формат JSON",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    },
                    "500": {
                        "description": "Ошибка поиска в БД, неверный пароль или ошибка создания сессии",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "description": "Удаляет авторизационную cookie (cookie_id) у клиента",
                "tags": [
                    "auth"
                ],
                "summary": "Выход из аккаунта",
                "responses": {
                    "200": {
                        "description": "Успешный выход из системы"
                    }
                }
            }
        },
        "/api/register": {
            "post": {
                "description": "Создает аккаунт пользователя в БД, генерирует сессионную cookie и устанавливает её в браузер",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Регистрация нового пользователя",
                "parameters": [
                    {
                        "description": "Данные для регистрации пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.CustomerRegisterData"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный формат JSON",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    },
                    "500": {
                        "description": "Ошибка хэширования пароля или записи в БД",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    }
                }
            }
        },
        "/api/sessions": {
            "post": {
                "description": "Создает новую сессию в БД для текущего пользователя (по cookie) и возвращает её UUID и статус",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Создать новую сессию чата",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.SessionForm"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    }
                }
            }
        },
        "/api/sessions/{session_id}/messages": {
            "get": {
                "description": "Находит и возвращает все сообщения пользователя и ИИ по указанному session_id для отрисовки чата",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Получить историю сообщений сессии",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID сессии",
                        "name": "session_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.UserHistoryForm"
                        }
                    },
                    "500": {
                        "description": "Ошибка при поиске истории в БД",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorForm"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.CustomerLoginData": {
            "type": "object",
            "properties": {
                "is_admin": {
                    "type": "boolean"
                },
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "main.CustomerRegisterData": {
            "type": "object",
            "properties": {
                "is_admin": {
                    "type": "boolean"
                },
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "main.ErrorForm": {
            "type": "object",
            "properties": {
                "detail": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "main.FrontHistoryMessageForm": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "rec_products": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "role": {
                    "type": "string"
                }
            }
        },
        "main.LeadForm": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "lead_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "main.ManagerStatementForm": {
            "type": "object",
            "properties": {
                "consent": {
                    "type": "boolean"
                },
                "contact": {
                    "$ref": "#/definitions/main.UserContactData"
                },
                "session_id": {
                    "type": "string"
                },
                "submission_id": {
                    "type": "string"
                }
            }
        },
        "main.RegisterResponse": {
            "type": "object",
            "properties": {
                "is_admin": {
                    "type": "boolean"
                },
                "login": {
                    "type": "string"
                }
            }
        },
        "main.SessionForm": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "session_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "main.UserContactData": {
            "type": "object",
            "properties": {
                "company": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "phone": {
                    "type": "string"
                }
            }
        },
        "main.UserHistoryForm": {
            "type": "object",
            "properties": {
                "history": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.FrontHistoryMessageForm"
                    }
                },
                "session_id": {
                    "type": "string"
                }
            }
        },
        "main.UserRequest": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                },
                "session_id": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "CookieAuth": {
            "type": "apiKey",
            "name": "cookie_id",
            "in": "cookie"
        }
    }
}