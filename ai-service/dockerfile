FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV MAIN_DIR=/app

# ── Шаг 1: torch CPU (точный pin, кавычки обязательны) ──
RUN pip install --no-cache-dir \
    "torch==2.7.0" \
    --index-url https://download.pytorch.org/whl/cpu

# ── Шаг 2: остальные зависимости ──
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Код ──
COPY API/ ./API/
COPY LLM/ ./LLM/
COPY RAG/ ./RAG/
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

# ── Пустые папки под Volume ──
RUN mkdir -p Models Storage/Index Storage/Source Storage/Catalog

EXPOSE 8001
CMD ["./entrypoint.sh"]