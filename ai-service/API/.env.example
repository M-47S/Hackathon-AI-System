# ============================================================
# EnergyTool AI Service — единый .env
#
# Как использовать:
#   1. Заполни AI_AUTH_KEY (обязательно)
#   2. Остальное — по умолчанию работает «из коробки»
#   3. python -m uvicorn API.main:app --host 0.0.0.0 --port 8001
# ============================================================

# ---------- LLM ----------
# GigaChat (по умолчанию)
AI_AUTH_KEY=
AI_SCOPE=GIGACHAT_API_PERS
AI_BASE_URL=https://api.giga.chat/v1
AI_MODEL=GigaChat-2-Pro

# ── Альтернатива: Gemini ──
# GEMINI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.0-flash
# (для Gemini не нужен AI_AUTH_KEY, работает через api_key=GEMINI_API_KEY)

# ── Альтернатива: OpenAI ──
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---------- RAG (пути к базе знаний и индексу) ----------
# База знаний (.md-файлы)
RAG_KB_DIR=C:/Users/0/OneDrive/Desktop/HackAI/ai-service/RAG/Store/_test_/Data Knowledge
# FAISS-индекс 
RAG_INDEX_DIR=C:/Users/0/OneDrive/Desktop/HackAI/ai-service/RAG/Store/Storage
# Сколько чанков брать после реранкера
RAG_TOP_K=5
# Включить реранкер (true/false)
RAG_RERANK=true

# ── Авто-сборка индекса (если его нет) ──
# true  — соберётся при старте за 1–3 мин, потом грузится из кэша мгновенно
# false — сервис упадёт с ошибкой, если индекса нет (для CI/прод-деплоя)
RAG_AUTO_BUILD=true
# Параметры чанкера (640/64 — оптимально по тестам Grader, score 0.6356)
RAG_CHUNK_SIZE=640
RAG_CHUNK_OVERLAP=64

# ---------- Модели (явные пути — не искать по проекту) ----------
# Embedder (multilingual-e5-large)
EMBEDDING_MODEL_NAME=C:/Users/0/OneDrive/Desktop/HackAI/ai-service/RAG/Embedding/models/multilingual-e5-large
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=10

# Reranker (bge-reranker-v2-m3)
RERANKER_MODEL_PATH=C:/Users/0/OneDrive/Desktop/HackAI/ai-service/RAG/Ranking/models/BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=1024

# ---------- Service ----------
AI_HOST=0.0.0.0
AI_PORT=8001
LOG_LEVEL=INFO